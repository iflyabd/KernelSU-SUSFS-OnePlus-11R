# Monitor-mode + USB WiFi/BT defconfig fragment for OnePlus 11R (SM8475, 5.10 GKI).
# Appended to the generated .config after gki_defconfig, then olddefconfig.
# KSU/SUSFS symbols are added by their own steps; must-keep (VERITY/SELINUX/
# CFI/LTO/DWC3/MMC/THERMAL) comes from stock gki_defconfig — never touched here.

# --- wireless stack for monitor mode + MT7601U USB (148f:7601, in-tree) ---
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_CFG80211_DEBUGFS=y
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211=y
CONFIG_MAC80211_MESH=y
CONFIG_MAC80211_LEDS=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7601U=m
CONFIG_WIRELESS_EXT=y
CONFIG_WEXT_CORE=y
CONFIG_WEXT_PROC=y

# --- USB Bluetooth: UGREEN CM748 RTL8761BU (in-tree btusb + hci_uart_rtl) ---
CONFIG_BT_BNEP=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_HCIUART_RTL=y

# --- 8761BU firmware built into Image (taken from host /lib/firmware in CI) ---
CONFIG_EXTRA_FIRMWARE="rtl_bt/rtl8761b_fw.bin rtl_bt/rtl8761b_config.bin"

# --- NAT / pentest netfilter set (base NETFILTER already y in GKI) ---
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNMARK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_IP_NF_TARGET_LOG=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IPV6_NF_IPTABLES=y
CONFIG_IPV6_NF_NAT=y

# --- pstore ramoops (crash/dmesg/pmsg survive reboot IF a RAM region is
# provided via DT reserved-memory or ramoops.* cmdline; stock bootloader
# provides none today, so pstore stays empty until the DT follow-up) ---
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_FTRACE=y
CONFIG_PSTORE_RAM=y

# --- module signatures OFF (unsigned test/out-of-tree modules must load) ---
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_SIG_FORCE is not set
# CONFIG_MODULE_SIG_ALL is not set

# --- OPLUS sensor devcfg predates stock: keep off (matches stock) ---
# CONFIG_OPLUS_FEATURE_SENSOR_CFG is not set
